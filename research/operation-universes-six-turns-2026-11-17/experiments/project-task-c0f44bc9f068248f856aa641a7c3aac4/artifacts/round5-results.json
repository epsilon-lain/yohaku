      "text": "    max_total = limits[\"max_total_relator_length\"]"
    },
    {
      "line": 238,
      "text": "    max_work = limits[\"max_work\"]"
    },
    {
      "line": 241,
      "text": "    work = tot"
    },
    {
      "line": 251,
      "text": "        if tot > max_total:"
    },
    {
      "line": 254,
      "text": "                        max_total_relator_length=max_total)"
    },
    {
      "line": 257,
      "text": "        work += tot"
    },
    {
      "line": 258,
      "text": "        if work > max_work:"
    },
